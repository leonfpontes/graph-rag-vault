{
  "name": "@graph-rag/embeddings",
  "version": "0.1.0",
  "private": true,
  "description": "The embedding model shared by the index (Node) and the browser: one open model pinned by id and revision, the query prefix, and the token counter for the chunker.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "graph-rag-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "graph-rag-source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0"
  }
}
