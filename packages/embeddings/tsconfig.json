{
  "extends": "../../tsconfig.base.json",
  // Runs in the browser too (the Ask worker): no Node types, so a Node API fails the typecheck.
  // src/node.ts is the Node entry (WASM runtime and the model file cache): checked by tsconfig.test.json.
  "compilerOptions": { "noEmit": true, "types": [], "lib": ["ES2023"] },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/node.ts"]
}
