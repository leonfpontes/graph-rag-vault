{
  "name": "@graph-rag/api",
  "version": "0.1.0",
  "private": true,
  "description": "The local API (search, note, graph, answer) and the server for the app and the demo.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "graph-rag-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@graph-rag/answer": "workspace:*",
    "@graph-rag/client": "workspace:*",
    "@graph-rag/embeddings": "workspace:*",
    "@graph-rag/search": "workspace:*"
  }
}
