{
  "name": "@graph-rag/vault",
  "version": "0.1.0",
  "private": true,
  "description": "Reads the Markdown vault: typed frontmatter, wikilinks and typed relations, as notes and links.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "graph-rag-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  }
}
