{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @graph-rag/web build && cp apps/web/dist/index.html apps/web/dist/404.html",
  "outputDirectory": "apps/web/dist",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/(explore|ask|evaluation)", "destination": "/index.html" },
    { "source": "/notes/:id([a-z0-9][a-z0-9-]*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
